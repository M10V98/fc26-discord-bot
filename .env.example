TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_client_id
GUILD_ID=your_discord_guild_id

# Required for random football chat replies.
OPENAI_API_KEY=your_openai_api_key

# Optional AI tuning.
OPENAI_MODEL=gpt-5.4-nano
AI_REPLY_CHANCE=0.08
AI_REPLY_COOLDOWN_MS=600000

# Optional. On Railway, point this at a mounted volume for persistent SQLite.
# Example: /data/database.sqlite
DATABASE_PATH=

# Optional World Cup integration overrides. The defaults use the website's
# public read-only Supabase anon key and the World Cup 2026 tournament.
WORLD_CUP_SUPABASE_URL=https://pagoqdpzbxpckhpqjoif.supabase.co
WORLD_CUP_SUPABASE_ANON_KEY=your_public_supabase_anon_key
WORLD_CUP_TOURNAMENT_SLUG=world-cup-2026
